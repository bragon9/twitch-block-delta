{
  "manifest_version": 2,
  "name": "Twitch Block Delta",
  "version": "0.7.0",
  "description": "Firefox-only Twitch ad blocker that splices ad-free live segments into the stream.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch-block-delta@bdudders",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "unlimitedStorage",
    "cookies",
    "downloads",
    "*://*.twitch.tv/*",
    "*://*.ttvnw.net/*",
    "*://*.live-video.net/*"
  ],
  "background": {
    "scripts": [
      "src/playlist.js",
      "src/splice.js",
      "src/delta.js",
      "src/capture.js",
      "src/ring.js",
      "src/probe.js",
      "src/blocker.js",
      "src/session.js",
      "src/background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Twitch Block Delta",
    "default_popup": "popup/popup.html"
  }
}
